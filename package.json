{
  "name": "mcp-quest",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "world"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:llm-free": "node scripts/check-llm-free.mjs",
    "check:scenarios": "tsx scripts/check-scenarios.ts",
    "ci": "npm run typecheck && npm run check:llm-free && npm run check:scenarios && npm test",
    "dev": "npm run dev -w @mcp-quest/game"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^26.6.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
